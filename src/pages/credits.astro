---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import credits from "@/data/wallpaper-credits.json";

type CreditItem = {
	index: number;
	pid: number;
	title: string;
	author: string;
	tags: string[];
	pageUrl: string;
	imageUrl: string;
};

const items = (credits.items ?? []) as CreditItem[];
---

<MainGridLayout title="图片来源" description="本站壁纸、头像与封面所用 Pixiv 作品的来源说明">
	<div class="card-base px-6 py-6 sm:px-9">
		<h1 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">图片来源</h1>
		<p class="mt-3 text-sm leading-6 text-neutral-600 dark:text-neutral-300">
			本站首页壁纸、头像与文章封面来自 Pixiv 公开作品（已过滤 R18 与 AI 作品），通过
			<a class="text-(--primary) hover:underline" href="https://api.lolicon.app/" target="_blank" rel="noopener noreferrer">Lolicon API</a>
			获取，并本地裁切压缩。作品版权归原作者所有，仅作个人博客装饰；如作者提出异议，会立即移除。
		</p>

		<div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
			{
				items.map((item) => (
					<div class="rounded-xl border border-black/5 bg-black/[0.02] p-4 dark:border-white/10 dark:bg-white/[0.03]">
						<div class="flex items-baseline justify-between gap-3">
							<span class="font-bold text-neutral-900 dark:text-neutral-100">{item.title || "无题"}</span>
							<span class="text-xs text-neutral-500 dark:text-neutral-400">Pixiv #{item.pid}</span>
						</div>
						<div class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">{item.author}</div>
						<div class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs">
							<a class="text-(--primary) hover:underline" href={item.pageUrl} target="_blank" rel="noopener noreferrer">
								作品页
							</a>
							<a class="text-(--primary) hover:underline" href={item.imageUrl} target="_blank" rel="noopener noreferrer">
								原图
							</a>
						</div>
					</div>
				))
			}
		</div>

		<p class="mt-6 text-xs leading-5 text-neutral-500 dark:text-neutral-400">
			图片经裁切、压缩后用于本站背景与头像，未用于商业用途。来源为 Pixiv 作品页，作者与标题由 Lolicon API 返回。
		</p>
	</div>
</MainGridLayout>